<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    
    <!--  DIESE ZEILE REPARIERT DEN GENERATOR-FEHLER -->
    <ImplicitUsings>disable</ImplicitUsings>

    <UseWPF>true</UseWPF>
    <!-- Zwingt den Compiler, die Namespaces nach Standard-WPF-Vorgaben aufzulösen -->
    <EnableDefaultXamlItems>true</EnableDefaultXamlItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecureChat.Core\SecureChat.Core.csproj" />
    <ProjectReference Include="..\SecureChat.Infrastructure\SecureChat.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 📞 DER NATIVE .NET 8 TELEFONIE-STACK (GEHÄRTET GEGEN KOSMETISCHE WARNUNGEN) -->
    <!-- 'NoWarn' blendet die NuGet-Audit-Sicherheitswarnungen für diese Pakete im Projektbaum aus -->
    <PackageReference Include="SIPSorcery" Version="8.0.14" NoWarn="NU1901;NU1902;NU1903;NU1904" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="8.0.11" NoWarn="NU1901;NU1902;NU1903;NU1904" />
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="8.0.11" NoWarn="NU1901;NU1902;NU1903;NU1904" />
    <PackageReference Include="SIPSorceryMedia.Windows" Version="6.0.4" NoWarn="NU1901;NU1902;NU1903;NU1904" />
  </ItemGroup>

</Project>

